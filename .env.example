# ─── THE SYSTEM · Environment Variables ──────────────────────────────
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# ── DATABASE (PostgreSQL — required) ─────────────────────────────────
# Free instant Postgres: https://neon.com → create project → copy the
# Prisma connection string here. Works for local dev AND production.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# ── AUTH ──────────────────────────────────────────────────────────────
# Secret used to sign JWT session tokens (32+ random chars). Generate with:
#   openssl rand -base64 32
JWT_SECRET="replace-with-a-long-random-string"

# ── PUBLIC ────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="THE SYSTEM"
